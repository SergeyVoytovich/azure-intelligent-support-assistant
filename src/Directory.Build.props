<Project>
  <PropertyGroup>
    <!-- Enable nullable reference type analysis for all projects -->
    <Nullable>enable</Nullable>

    <!-- Enable common framework namespaces automatically -->
    <ImplicitUsings>enable</ImplicitUsings>

    <!-- Use the recommended analyzer set for the installed .NET SDK -->
    <AnalysisLevel>latest-recommended</AnalysisLevel>

    <!-- Apply .editorconfig code-style rules during build -->
    <EnforceCodeStyleInBuild>true</EnforceCodeStyleInBuild>

    <!-- Produce reproducible build outputs -->
    <Deterministic>true</Deterministic>

    <!-- Enable additional deterministic CI behaviour in pipelines -->
    <ContinuousIntegrationBuild Condition="'$(CI)' == 'true'">true</ContinuousIntegrationBuild>
  </PropertyGroup>
</Project>